# Rose n Petals Environment Configuration
PORT=8080

# Admin Dashboard Password
ADMINPASSWORD=test6868

# Telegram Owner Approval Bot
# 1. Obtain TELEGRAM_BOT_TOKEN from @BotFather on Telegram (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
# 2. Obtain TELEGRAM_CHAT_ID by messaging your bot or checking via @userinfobot / @getidsbot (e.g. 987654321)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Firebase Admin SDK Service Account JSON
# In Firebase Console: Project Settings -> Service accounts -> Generate new private key
# Paste the entire JSON file as a single-line string (or set as environment variable in Render):
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"rose-n-petals-az3b9","private_key_id":"...","private_key":"...","client_email":"..."}

# Google Apps Script HTTP Webhook for Email Delivery (Bypasses Render SMTP port blocking)
# Deploy a Google Apps Script Web App with doGet/doPost and paste the Web App URL:
GOOGLE_EMAIL_WEBHOOK=https://script.google.com/macros/s/your_deployment_id/exec

# Customer Care WhatsApp Number (defaults to 917289996804)
SHOP_PHONE=917289996804

# Razorpay Payment Gateway & Webhook
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Secret configured in Razorpay Dashboard -> Webhooks -> Add New Webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here